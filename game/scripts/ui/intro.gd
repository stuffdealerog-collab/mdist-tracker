class_name Intro
extends RefCounted
## "How to play" multi-page modal.

const PAGES := [
	["Своя мастерская дома", "Вы собираете и чините механические клавиатуры прямо у себя в комнате. Утром — звонок в дверь: сосед оставил сломанную клавиатуру. Заработайте имя ремонтом, потом собирайте кастомные клавиатуры своими руками, купите офис, а потом и бутик клавиатур и периферии.\n\n[b]Управление:[/b] WASD — ходить, мышь — смотреть, E или ЛКМ — действие, R — второе действие, Tab — телефон, Esc — меню.\n\n[color=#8a97a3]Вернуться к инструкции можно через Esc → «Как играть».[/color]"],
	["Цикл игры", "[b]1. Заказы.[/b] Клиенты пишут на компьютер и телефон: ремонт или сборка по ТЗ.\n[b]2. KeyMarket.[/b] Детали заказываются заранее и едут курьером 2–4 часа. Курьер работает с 09:00 до 21:00 и оставляет коробки у двери.\n[b]3. Распаковка.[/b] Отнесите коробку на верстак: разрежьте скотч, откройте клапаны, достаньте детали, снимите плёнку.\n[b]4. Склад.[/b] Лишнее уберите в шкаф (R у верстака), под новый заказ возьмите детали из шкафа (E).\n[b]5. Сборка и ремонт[/b] — за верстаком, руками.\n[b]6. Отправка.[/b] На упаковочном столе уложите клавиатуру в фирменную коробку, заклейте, наклейте этикетку и оставьте у двери: курьер заберёт и привезёт деньги."],
	["Откуда берётся звук", "Каждая деталь меняет звук. [b]Thock[/b] — глубокий, «пузатый». [b]Clack[/b] — высокий и звонкий.\n\n[b]Свитчи[/b] — основа звука, это настоящие записи.\n[b]Кейкапы:[/b] PBT глубже, ABS звонче, высокие профили громче.\n[b]Пластина:[/b] поликарбонат и POM мягче, латунь и алюминий звонче.\n[b]Моды:[/b] пенка убирает гулкость, tape-mod углубляет, PE-фоам даёт «попкорн».\n[b]Смазка[/b] убирает царапание и звон пружин."],
	["Как собирать", "1. Вставьте плату и пластину в корпус нужной стороной (R — повернуть)\n2. Поставьте стабилизаторы под длинные клавиши\n3. Смажьте свитчи кисточкой\n4. Вставляйте свитчи, ведя мышью по сокетам, — не спешите\n5. Затяните винты крест-накрест с правильным усилием\n6. Наденьте кейкапы: каждый ряд в свой ряд\n7. Проверьте все клавиши и почините мёртвые\n\n[b]Мышь:[/b] левая кнопка — инструмент, правая — вращать камеру, колесо — зум."],
	["Онлайн и коробки", "[b]Коробки[/b] покупаются только за игровые деньги, шансы всегда указаны. Если игра подключена к серверу, выпавшие предметы получают онлайн-номер.\n\n[b]Барахолка:[/b] меняйтесь онлайн-предметами с живыми игроками или с торговцами города.\n\n[b]Лидеры:[/b] таблица мастерских и недельный конкурс."],
	["Возвращайтесь каждый день", "[b]Награда за вход:[/b] серия растёт, растут и награды.\n[b]Задания дня и недели[/b] открывают сундуки.\n[b]Group buy:[/b] лимитированные детали недели с доставкой в реальном времени.\n[b]Витрина[/b] торгует, даже когда игра закрыта.\n[b]Филиалы:[/b] на 25 уровне откройте мастерскую в новом городе."],
]

static func open(main, i := 0) -> void:
	var p: Array = PAGES[i]
	var dots = UIK.hbox(6)
	for j in PAGES.size():
		var d = Panel.new(); d.custom_minimum_size = Vector2(22 if j == i else 8, 8)
		d.add_theme_stylebox_override("panel", UIK.sb(UIK.TEAL if j == i else UIK.LINE, 4, Color(0, 0, 0, 0), 0)); dots.add_child(d)
	var row = UIK.hbox(8, [dots, UIK.spacer()])
	if i > 0: row.add_child(UIK.button("Назад", "BtnGhost", func(): open(main, i - 1)))
	if i < PAGES.size() - 1: row.add_child(UIK.button("Далее", "BtnPri", func(): open(main, i + 1)))
	else: row.add_child(UIK.button("Начать играть", "BtnPri", func(): _done(main), "play"))
	var skip = UIK.button("Пропустить", "BtnGhost", func(): _done(main))
	var art = Control.new(); art.custom_minimum_size = Vector2(0, 8)
	var v = UIK.vbox(14, [UIK.hbox(8, [UIK.label("КАК ИГРАТЬ · %d ИЗ %d" % [i + 1, PAGES.size()], "Eyebrow"), UIK.spacer(), skip]), UIK.label(p[0], "H1"), UIK.rich(p[1], 15), art, row])
	if i == 0: v.add_child(CapsRow.make("k_miami", 40)); v.move_child(v.get_child(v.get_child_count() - 1), 3)
	main.open_modal(v, 680)

static func _done(main) -> void:
	Game.S.seenIntro = true; Game.mark(); main.close_modal()
