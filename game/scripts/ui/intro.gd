static func open(main, i := 0) -> void:
	var p: Array = PAGES[i]
	var dots = UIK.hbox(6)
	for j in PAGES.size():
		var d = Panel.new(); d.custom_minimum_size = Vector2(22 if j == i else 8, 8)
		d.add_theme_stylebox_override("panel", UIK.sb(UIK.TEAL if j == i else UIK.LINE, 4, Color(0, 0, 0, 0), 0)); dots.add_child(d)
	var row = UIK.hbox(8, [dots, UIK.spacer()])
	if i > 0: row.add_child(UIK.button("Назад", "BtnGhost", func(): open(main, i - 1)))
	if i < PAGES.size() - 1: row.add_child(UIK.button("Далее", "BtnPri", func(): open(main, i + 1)))
	else: row.add_child(UIK.button("Начать играть", "BtnPri", func(): _done(main), "play"))
	var skip = UIK.button("Пропустить", "BtnGhost", func(): _done(main))
	var art = Control.new(); art.custom_minimum_size = Vector2(0, 8)
	var v = UIK.vbox(14, [UIK.hbox(8, [UIK.label("КАК ИГРАТЬ · %d ИЗ %d" % [i + 1, PAGES.size()], "Eyebrow"), UIK.spacer(), skip]), UIK.label(p[0], "H1"), UIK.rich(p[1], 15), art, row])
	if i == 0: v.add_child(CapsRow.make("k_miami", 40)); v.move_child(v.get_child(v.get_child_count() - 1), 3)
	main.open_modal(v, 680)

static func _done(main) -> void:
	Game.S.seenIntro = true; Game.mark(); main.close_modal()
